<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="reason_for_lost_form" model="ir.ui.view">
        <field name="name">lost.reason.form</field>
        <field name="model">lost.wizard</field>
        <field name="arch" type="xml">
            <form string="Lost Reason Form">
                <group>
                    <field name="lost_reason"/>
                </group>

                <footer>
                    <button name="action_lost_reason" string="Submit" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="reason_for_lost_action" model="ir.actions.act_window">
        <field name="name">Lost Reason</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">lost.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="reason_for_lost_form"/>
    </record>
</odoo>