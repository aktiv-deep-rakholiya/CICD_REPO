<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="visit_summary_report_view" model="ir.ui.view">
        <field name="name">Timesheet Report</field>
        <field name="model">visit.summary.report</field>
        <field name="inherit_id" ref="project_management.view_common_report"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vendor_id']" position="after">
                <field name="role_id" options="{'no_create': True, 'no_open': True}"/>
            </xpath>
        </field>
    </record>

    <record id="action_visit_summary_report_menu" model="ir.actions.act_window">
        <field name="name">Timesheet Report</field>
        <field name="res_model">visit.summary.report</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="visit_summary_report_view"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_timesheet_summary_report_main" name="Timesheet Reports" parent="project_management.menu_timesheet_summary_main_root" sequence="2"/>

     <menuitem id="menu_visit_summary_report" name="Timesheet" action="action_visit_summary_report_menu" parent="menu_timesheet_summary_report_main" sequence="1"/>
</odoo>
