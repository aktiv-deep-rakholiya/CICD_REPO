<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="tecnicas_summary_report_view" model="ir.ui.view">
        <field name="name">Tecnicas Timesheet Report</field>
        <field name="model">tecnicas.reunidas.summary.report</field>
        <field name="inherit_id" ref="project_management.view_common_report"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='project_id']" position="after">
                <field name="agency_idd" options="{'no_create': True, 'no_open': True}"/>
            </xpath>
        </field>
    </record>

    <record id="tecnicas_summary_report_menu" model="ir.actions.act_window">
        <field name="name">TR Timesheet Report</field>
        <field name="res_model">tecnicas.reunidas.summary.report</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="tecnicas_summary_report_view"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_tecnicas_report" name="Tecnicas Reunidas" action="tecnicas_summary_report_menu" parent="prime4_report.menu_timesheet_summary_report_main" sequence="15"/>

</odoo>