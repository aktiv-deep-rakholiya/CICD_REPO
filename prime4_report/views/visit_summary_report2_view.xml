<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="visit_summary_report_view2" model="ir.ui.view">
        <field name="name">Timesheet Report</field>
        <field name="model">visit.summary.report2</field>
        <field name="inherit_id" ref="project_management.view_common_report"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vendor_id']" position="after">
                <field name="role_id" options="{'no_create': True, 'no_open': True}"/>
            </xpath>
        </field>
    </record>

    <record id="action_visit_summary_report_menu2" model="ir.actions.act_window">
        <field name="name">Timesheet Report</field>
        <field name="res_model">visit.summary.report2</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="visit_summary_report_view2"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_visit_summary_report2" name="Tecnimont" action="action_visit_summary_report_menu2" parent="menu_timesheet_summary_report_main" sequence="2"/>

</odoo>

