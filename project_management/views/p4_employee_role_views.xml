<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="employee_role_tree_view" model="ir.ui.view">
        <field name="name">employee.role.tree</field>
        <field name="model">p4.employee.role</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="employee_role_form_view" model="ir.ui.view">
        <field name="name">employee.role.form</field>
        <field name="model">p4.employee.role</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" required="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_employee_role" model="ir.actions.act_window">
        <field name="name">Employee Role</field>
        <field name="res_model">p4.employee.role</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>

    <menuitem id="menu_employee_role" name="Employee Role" sequence="5"
              action="action_employee_role" parent="master_root_menu"/>

</odoo>
