<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pricelist_master_view" model="ir.ui.view">
        <field name="name">pricelist.master.tree</field>
        <field name="model">pricelist.master</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" optional="show"/>
                 <field name="client_id" optional="show" />
            </list>
        </field>
    </record>

    <record id="pricelist_master_form_view" model="ir.ui.view">
        <field name="name">pricelist.master.form</field>
        <field name="model">pricelist.master</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name" required="1"/>
                        </group>
                        <group>
                           <field name="client_id" required="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pricelist_master" model="ir.actions.act_window">
        <field name="name">Pricelist Master</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">pricelist.master</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>

</odoo>
