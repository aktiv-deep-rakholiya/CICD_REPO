<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="0">
    <record id="group_enquiry_coordinator" model="res.groups">
        <field name="name">Commercial Coordinator</field>
    </record>

    <record id="group_enquiry_ceo" model="res.groups">
        <field name="name">CEO</field>
    </record>

	<record id="group_p4_coordinator" model="res.groups">
		<field name="name">Inspection Coordinator</field>
		<field name="implied_ids" eval="[
		(4, ref('base.group_user')),
		(4, ref('project.group_project_manager'))]"/>
	</record>

	<record id="group_p4_reviewer" model="res.groups">
		<field name="name">Report Reviewer</field>
		<field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
	</record>

	<record id="group_p4_manager" model="res.groups">
		<field name="name">Operational Manager</field>
		<field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
	</record>

    <record id="project_rule_model_progress_activity_line" model="ir.rule">
        <field name="name">Progress Activity Line</field>
        <field ref="model_progress_activity_line" name="model_id"/>
        <field name="domain_force">[(1,'=',1)]</field>
    </record>

	<record id="calendar_rule_model_eigl_person" model="ir.rule">
        <field name="name">EIGL</field>
        <field ref="model_eigl_person" name="model_id"/>
        <field name="domain_force">[(1,'=',1)]</field>
    </record>
	
	<record id="calendar_rule_model_p4_employee_role" model="ir.rule">
        <field name="name">Employee Role</field>
        <field ref="model_p4_employee_role" name="model_id"/>
        <field name="domain_force">[(1,'=',1)]</field>
    </record>
	
	<record id="accounts_role" model="res.groups">
        <field name="name">Accounts</field>
    </record>

    <record id="group_allow_include_pending_timesheet" model="res.groups">
        <field name="name">Allow to include Pending Timesheet</field>
    </record>

    <record id="group_skip_man_day" model="res.groups">
        <field name="name">Allow to skip Man days in Report/Billing</field>
    </record>

   <record id="group_allow_reopen" model="res.groups">
        <field name="name">Allow Re-Open</field>
    </record>

    <record id="project_management.group_allow_reopen" model="res.groups">
        <field name="users" eval="[(4, ref('base.default_user'))]"/>
    </record>
    
    <record id="project_management.group_p4_coordinator" model="res.groups">
        <field name="users" eval="[(4, ref('base.default_user'))]"/>
    </record>

</data>
</odoo>
