<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--    Inherit payment provider form view-->
    <record id="payment_provider_view_form_inherits_by_fps" model="ir.ui.view">
        <field name="name">payment.provider.view.form.inherits.by.fps</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="is_delivery_verification"/>
            </xpath>
        </field>
    </record>
</odoo>
