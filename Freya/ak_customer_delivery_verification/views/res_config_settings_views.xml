<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--    Inherit res config settings form view -->
    <record id="res_config_settings_view_form_inherits_by_fps" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.base.setup.by.fps</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='contacts_settings']" position="inside">
                <div id="notification_share">
                    <block class='notification_share' name="notification_share_setting_container">
                        <setting help="Comma-separated list of email"
                                 id="notification_share_by_fp">
                            <field name="notification_share"/>
                        </setting>
                    </block>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
