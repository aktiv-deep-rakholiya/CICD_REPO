<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <template id="report_purchaseorder_document">
            <t t-call="web.html_container">
                <t t-if="o.rpt_prime or o.rpt_lind or o.rpt_petro">
                    <div class="header">
                        <img class="img" t-if="o.rpt_prime"  height="120" width="700" src='/p4_purchase_order_10/static/src/img/prime4.png'/>
                        <img class="img" t-if="o.rpt_lind"  height="120" width="700" src='/p4_purchase_order_10/static/src/img/lindinger_header.png'/>
                        <img class="img" t-if="o.rpt_petro" height="120" width="700" src='/p4_purchase_order_10/static/src/img/prime4petro.png'/>
			        </div>
                </t>
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="oe_structure"/>
                        <style type="text/css">
                            .tg  {border-collapse:collapse;border-spacing:0;border-color:#ccc;}
                            .tg td{font-family:Arial, sans-serif;font-size:12px;border-style:solid;border-width:2px;overflow:hidden;word-break:normal;border-color:#000;color:#000;background-color:#fff;padding-left: 5px;}
                            tr.noBorder td {
                                border: 0;
                            }
                        </style>

                        <table class="tg">
                            <tbody>
                            <tr >
                                <td style="width: 57%;" colspan="2"><![CDATA[&nbsp;]]><strong>Service Agreement Order No:</strong>
                                    <span style="text-align:right;" t-field="o.name"/></td>
                                <td style="width: 61%;" colspan="3"><strong>Date:
                                </strong> <span t-field="o.date_order" style="text-align:right;" t-options="{'widget': 'date', 'format': 'dd-MM-yyyy'}"/>
                                </td>
                            </tr>
                            <tr >
                                <td style="width: 10%;"><![CDATA[&nbsp;]]><strong>TO:</strong></td>
                                <td style="width: 47%;"><span t-field="o.partner_id"
                                                        t-field-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": true}'/>
                                </td>
                                <td style="width: 10%;"><strong>CLIENT / PROJECT<![CDATA[&nbsp;]]></strong></td>
                                <td style="width: 51%;" colspan="2"><span t-field="o.client_id.name"/> / <span t-field="o.project_id.name"/></td>
                            </tr>
                            <tr style="height: 8px;">
                                <td style="width: 10%;">
                                <p><![CDATA[&nbsp;]]><strong>Attn:</strong><br/>
                                <![CDATA[&nbsp;]]><strong>Tel:-</strong></p>
                                </td>
                                <td style="width: 47%;">
                                <p><span t-field="o.attn"/><br/>
                                <span t-field="o.partner_id.phone"/></p>
                                </td>
                                <td style="width: 10%;" colspan="1" ><strong>PO Ref: </strong></td>
                                <td style="width: 51%;" colspan="2"><span t-field="o.po_ref"/></td>

                            </tr>
                            <tr >
                                <td style="width: 10%;"><strong><![CDATA[&nbsp;]]>email:</strong></td>
                                <td style="width: 47%;"><span t-field="o.partner_id.email"/></td>
                                <td style="width: 61%;" colspan="3" rowspan="1">
                                <p t-if="o.rate_type == 'man_day'">
                                <strong> Agreed email Dated:</strong><span t-field="o.mail_dated" t-field-options='{"format": "dd - MMMM- y"}'/></p>
                                <p t-if="o.rate_type == 'man_month'">
                                <strong> Agreed email Dated:</strong><span t-field="o.mail_dated" t-field-options='{"format": "dd - MMMM- y"}'/></p>
                                </td>
                            </tr>
                            <tr >
                                <td style="width: 57%;" colspan="2" rowspan="2">
                                <p><![CDATA[&nbsp;]]><strong>TERMS AND CONDITION</strong></p>
                                <p><![CDATA[&nbsp;]]>1. Mention SA number on each invoice.</p>
                                <p><![CDATA[&nbsp;]]>2. Submit only one invoice at end of each month.</p>
                                <p><![CDATA[&nbsp;]]>3. Payment will be made 30 working days after invoice submission.</p>
                                <p><![CDATA[&nbsp;]]>4. email invoice to&amp;nbsp;&amp;nbsp;&amp;nbsp;<a href="mailto:daksha@prime4inspection.net">daksha@prime4inspection.net</a></p>
                                <p><![CDATA[&nbsp;]]>5. Submit supporting documents to claim additional charges , if approved separately.</p>
                                </td>
                                <td style="width: 61%;" colspan="3">
                                <p><strong>DELIVERABLE</strong></p>
                                <p><span t-field="o.deliverable"/></p>
                                </td>
                            </tr>
                            <tr>
                                <td style="width: 61%;" colspan="3">
                                <strong><![CDATA[&nbsp;]]>DELIVERY DATE</strong>
                                <p><![CDATA[&nbsp;]]>Visit Report / Flash Report within 24 Hrs of Visit</p>
                                <p><![CDATA[&nbsp;]]>Inspection / Expediting Report within 48 Hrs of Visit</p>
                                <p style="color: red;"><span style="color: red;"><![CDATA[&nbsp;]]><strong>Delayed reports may result in non-payment for visit</strong></span></p>
                                </td>
                                </tr>
                            <tr>
