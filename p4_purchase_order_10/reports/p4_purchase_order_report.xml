<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Custom "Service Agreement" report replacing default RFQ/PO -->
        <record id="action_report_service_agreement" model="ir.actions.report">
            <field name="name">Service Agreement</field>
            <field name="model">purchase.order</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">p4_purchase_order_10.report_purchaseorder</field>
            <field name="report_file">p4_purchase_order_10.report_purchaseorder</field>
            <field name="print_report_name">'Service Agreement - %s' % (object.name)</field>
            <field name="binding_model_id" ref="model_purchase_order"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="base.paperformat_euro"/> <!-- optional -->
        </record>

        <!-- Disable default RFQ report -->
        <record id="purchase.report_purchase_quotation" model="ir.actions.report">
            <field name="binding_model_id" eval="False"/>
        </record>

        <!-- Disable default Purchase Order report -->
        <record id="purchase.action_report_purchase_order" model="ir.actions.report">
            <field name="binding_model_id" eval="False"/>
        </record>

    </data>
</odoo>
