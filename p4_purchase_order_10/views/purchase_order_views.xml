<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="purchase_order_view_form" model="ir.ui.view">
        <field name="name">purchase.order.view.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list//field[@name='product_id']" position="attributes">
                <attribute name="domain">[('name','=', '###')]</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list//field[@name='taxes_id']" position="attributes">
                <attribute name="column_invisible">parent.is_service_agreement</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//field[@name='taxes_id']" position="attributes">
                <attribute name="invisible">parent.is_service_agreement</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="context">{'res_partner_search_mode': 'supplier', 'show_vat': True, 'default_supplier_rank': 1, 'default_is_service_partner': is_service_agreement}</attribute>
            </xpath>

            <xpath expr="//field[@name='partner_ref']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <field name="partner_ref" position="after">
                <field name="client_id"  invisible="not is_service_agreement"/>
                <field name="project_id" invisible="not is_service_agreement"/>
                <field name="deliverable" invisible="not is_service_agreement"/>
                <field name="client_rate" invisible="not is_service_agreement"/>
                <field name="rate_type" string="Rate" invisible="not is_service_agreement"/>
            </field>
            <field name="partner_id" position="before">
                <field name="is_service_agreement" force_save="1" invisible="1"/>
            </field>
            <field name="date_order" position="after">
                <field name="mail_dated" invisible="not is_service_agreement"/>
            </field>

            <field name="mail_dated" position="after">
                <field name="po_ref" invisible="not is_service_agreement"/>
                <field name="attn" invisible="not is_service_agreement"/>
                <field name="description" invisible="1"/>
                <field name="rpt_prime" invisible="not is_service_agreement"/>
                <field name="rpt_lind" invisible="not is_service_agreement"/>
                <field name="rpt_petro" invisible="not is_service_agreement"/>
            </field>
            <field name="name" position="attributes">
                <attribute name="readonly">False</attribute>
            </field>
        </field>
    </record>

    <record id="purchase_order_tree_view" model="ir.ui.view">
        <field name="name">purchase.order.tree.view</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_tree"/>
        <field name="arch" type="xml">
            <field name="invoice_status" position="attributes">
                <attribute name="invisible">True</attribute>
            </field>
        </field>
    </record>

    <record id="view_order_form_inherit_project_purchase" model="ir.ui.view">
        <field name="name">purchase.order.form.view</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="project_purchase.view_order_form_inherit_project_purchase"/>
        <field name="arch" type="xml">
            <field name="project_id" position="attributes">
                <attribute name="invisible">True</attribute>
            </field>
        </field>
    </record>




    <record id="action_service_agreement" model="ir.actions.act_window">
        <field name="name">Service Agreements</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">list,kanban,form,pivot,graph,calendar,activity</field>
        <field name="domain">[('is_service_agreement', '=', True)]</field>
        <field name="context">{'default_is_service_agreement': True}</field>
    </record>

    <menuitem id="service_agreement_root_menu" action="action_service_agreement" name="Service Agreement"/>

</odoo>
