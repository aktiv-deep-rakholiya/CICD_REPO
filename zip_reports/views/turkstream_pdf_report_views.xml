<odoo>

    <template id="report_timesheet_pdf_turkstream">
        <t t-call="web.html_container">
            <main>
                <div class="page">
                    <style>
                        th, td {
                            word-break: break-word;
                        }
                    </style>
                    <table style="width:100%; border-collapse:collapse; font-size:10px;" border="1">
                        <thead>
                            <tr style="height:0; line-height:0; font-size:0; visibility:hidden; border:none">
                                <td style="width:12%; padding:0; "></td>
                                <td style="width:11%; padding:0; "></td>
                                <td style="width:15%; padding:0;"></td>
                                <td style="width:11%; padding:0; "></td>
                                <td style="width:10%; padding:0; "></td>
                                <td style="width:12%; padding:0; "></td>
                                <td style="width:4%; padding:0; "></td>
                                <td style="width:5%; padding:0; "></td>
                                <td style="width:7%; padding:0; "></td>
                                <td style="width:6%; padding:0; "></td>
                                <td style="width:7%; padding:0; "></td>
                            </tr>
                            <tr>
                                <td colspan="11" style="font-weight:bold; text-align:center;">
                                    Timesheet for the month of
                                    <t t-esc="data.get('month')"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="font-weight:bold;">
                                Service Order Number With Petrofac
                                </td>

                                <td colspan="10">
                                    <t t-esc="data.get('service_order')"/>
                                </td>
                            </tr>

                            <tr>
                                <td style="font-weight:bold;">
                                Name of Inspector
                                </td>
                                <td colspan="10">
                                    <t t-esc="data.get('employee')"/>
                                </td>
                            </tr>

                            <tr style="background:#99CCFF; font-weight:bold; text-align:center;">
                                <td>Dates</td>
                                <td>PO No</td>
                                <td>Vendor</td>
                                <td>Location</td>
                                <td>Role</td>
                                <td>Report Number</td>
                                <td>Days</td>
                                <td>Extra Hrs</td>
                                <td>Amount</td>
                                <td>Kms</td>
                                <td>Rate</td>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="data.get('rows')" t-as="row">
                                <tr>
                                    <td style="text-align:center;">
                                        <t t-esc="row.get('start')"/>
                                    </td>

                                    <td style="text-align:center;">
                                        <t t-esc="row.get('purchase')"/>
                                    </td>

                                    <td style="text-align:center;">
                                        <t t-esc="row.get('vendor')"/>
                                    </td>

                                    <td style="text-align:center;">
                                        <t t-esc="row.get('location')"/>
                                    </td>

                                    <td style="text-align:center;">
                                        <t t-esc="row.get('employee_role')"/>
                                    </td>

                                    <td style="text-align:center;">
                                        <t t-esc="row.get('number')"/>
                                    </td>

                                    <td style="text-align:center;">

                                        <t t-if="row.get('allday')">1</t>
                                        <t t-elif="row.get('abortive_visit')">Abortive</t>
                                        <t t-else="">0.5</t>

                                    </td>

                                    <td style="text-align:center;">
                                        <t t-esc="row.get('extra_hrs')"/>
                                    </td>

                                    <td></td>

                                    <td style="text-align:center;">
                                        <t t-esc="row.get('kms')"/>
                                    </td>

                                    <td></td>

                                </tr>
                            </t>

                            <tr>

                                <td colspan="5"></td>

                                <td style="font-weight:bold;">
                                Total
                                </td>

                                <td style="text-align:center;">
                                    <t t-esc="data.get('total_days')"/>
                                </td>

                                <td colspan="4"></td>

                            </tr>

                            <tr>

                                <td style="background:#99CCFF; font-weight:bold;">
                                Daily Rate
                                </td>

                                <td colspan="4"></td>

                                <td style="font-weight:bold;">
                                Abortive Total
                                </td>

                                <td style="text-align:center;">
                                    <t t-esc="data.get('abortive_total')"/>
                                </td>

                                <td colspan="4"></td>

                            </tr>

                            <tr>

                                <td style="background:#99CCFF; font-weight:bold;">
                                KM Rate (Above 100 KM)
                                </td>

                                <td colspan="4"></td>

                                <td style="background:#99CCFF; font-weight:bold;">
                                Total Invoice Amount
                                </td>

                                <td></td>

                                <td colspan="4"></td>

                            </tr>

                            <tr>

                                <td colspan="2" style="font-weight:bold;">
                                Name of Approving Authority
                                </td>

                                <td colspan="3">
                                    <t t-esc="data.get('approver')"/>
                                </td>

                                <td colspan="6" style="font-weight:bold;">
                                Signature of Approving Authority
                                </td>

                            </tr>

                            <tr>

                                <td style="font-weight:bold;">Date</td>

                                <td colspan="10"></td>

                            </tr>
                        </tbody>
                    </table>
                </div>
            </main>
        </t>
    </template>

    <record id="turkstream_A4_paperformat" model="report.paperformat">
        <field name="name">Turkstream Paperformat</field>
        <field eval="True" name="default"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">5</field>
        <field name="margin_bottom">5</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field eval="False" name="header_line"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_timesheet_pdf_turkstream" model="ir.actions.report">
        <field name="name">Timesheet Turkstream PDF</field>
        <field name="model">calendar.event</field>
        <field name="report_type">qweb-pdf</field>
        <field name="paperformat_id" ref="zip_reports.turkstream_A4_paperformat"/>
        <field name="report_name">zip_reports.report_timesheet_pdf_turkstream</field>
        <field name="report_file">zip_reports.report_timesheet_pdf_turkstream</field>
    </record>

</odoo>
