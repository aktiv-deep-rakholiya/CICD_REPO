<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_management_view_form" model="ir.ui.view">
        <field name="name">project.management.view.form</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project_management.project_management_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='inspection_contract_no']" position="after">
                <field name="service_order_no_ids" widget="many2many_tags"/>
                <field name="approving_authority"/>
            </xpath>
        </field>
    </record>
</odoo>
