<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="client_initiator_tree_view" model="ir.ui.view">
        <field name="name">client.initiator.tree.view</field>
        <field name="model">client.initiator</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
             <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="client_initiator_form_view" model="ir.ui.view">
        <field name="name">client.initiator.form.view</field>
        <field name="model">client.initiator</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
             <form>
                 <group>
                     <group>
                         <field name="name" required="1"/>
                     </group>
                 </group>
            </form>
        </field>
    </record>

    <record id="action_client_initiator" model="ir.actions.act_window">
        <field name="context">{}</field>
        <field name="name">Client Initiator</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">client.initiator</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_client_initiator" name="Initiator" action="action_client_initiator" parent="menu_configuration_main_menu" sequence="1"/>
</odoo>
