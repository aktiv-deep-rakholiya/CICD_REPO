<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="petrofac_turk_summary_report_view" model="ir.ui.view">
        <field name="name">Petrofac Timesheet Report</field>
        <field name="model">petrofac.turk.summary.report</field>
        <field name="inherit_id" ref="project_management.view_common_report"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='project_id']" position="after">
                <field name="service_no"  invisible="1" widget="many2many_tags" options="{'no_create': True, 'no_open': True}"/>
            </xpath>
        </field>
    </record>

    <record id="action_petrofac_turk_summary_report_menu" model="ir.actions.act_window">
        <field name="name">Petrofac Timesheet Report</field>
        <field name="res_model">petrofac.turk.summary.report</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="petrofac_turk_summary_report_view"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_petrofac_turk_report" name="Petrofac" action="action_petrofac_turk_summary_report_menu" parent="prime4_report.menu_timesheet_summary_report_main" sequence="4"/>

</odoo>
