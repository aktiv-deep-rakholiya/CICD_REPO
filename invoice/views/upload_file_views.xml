<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="upload_wizard_view_form" model="ir.ui.view">
        <field name="name">Upload file</field>
        <field name="model">upload.wizard</field>
        <field name="arch" type="xml">
            <form string = "Upload File">
                <group>
                    <group>
                        <field name="file_name" string="File name" invisible="1" />
                        <field name="file" string="Upload your file" filename="file_name" required="1"/>
                    </group>
                </group>

                <footer>
                    <button string="Submit" name="action_upload_btn" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="upload_action" model="ir.actions.act_window">
        <field name="name">Upload file</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">upload.wizard</field>
        <field name="view_mode">form</field>  
        <field name="target">new</field>
        <field name="view_id" ref="upload_wizard_view_form" />
        
    </record>

    <menuitem id="upload_action_menu" sequence="2" action="upload_action" parent="menu_invoice" name ="Excel Upload"/>
</odoo>
