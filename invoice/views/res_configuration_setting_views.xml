<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="eur_usd_aed_currency_res_config_settings" model="ir.ui.view">
        <field name="name">eur.usd.aed.currency</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='main_currency']" position="after">
                <div class="col-12 col-lg-6 o_setting_box" id="eur_currency">
                    <div class="o_setting_left_pane"/>
                    <div class="o_setting_right_pane">
                        <span class="o_form_label">AED Currency</span>
                        <span class="fa fa-lg fa-building-o" title="Values set here are company-specific."
                              aria-label="Values set here are company-specific." groups="base.group_multi_company"
                              role="img"/>
                        <div class="text-muted">
                            EUR to AED currency value &amp;
                            USDto AED currency Value
                        </div>
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="eur_to_aed" class="col-lg-3 o_light_label"/>
                                <field name="eur_to_aed"/>
                            </div>
                        </div>
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="usd_to_aed" class="col-lg-3 o_light_label"/>
                                <field name="usd_to_aed"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
