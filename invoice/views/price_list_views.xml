<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_excel_upload" model="ir.actions.server">
        <field name="name">Upload Excel</field>
        <field name="model_id" ref="invoice.model_price_list"/>
        <field name="binding_model_id" ref="invoice.model_price_list"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">records=records.action_excelupload()</field>
    </record>

    <record id="price_list_tree_view" model="ir.ui.view">
        <field name="name">price.list.tree</field>
        <field name="model">price.list</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button name="action_excelupload1" string="Upload Excel" type="object" class="oe_highlight"/>
                </header>
                <field name="pos" optional="show" string='POS'/>
                <field name="country" optional="show" string='Country'/>
                <field name="cat_location" optional="show" string='Location'/>
                <field name="services" optional="show" string='Services'/>
                <field name="employee_role" optional="show" string='Role'/>
                <field name="oncall" optional="show" string="OnCall-1 to19-DayExp"/>

                <field name="resident1" optional="show" string="Resident1- 20to27-Day Exp"/>
                <field name="resident2" optional="show" string="Resident2- 28to78-Day Exp"/>
                <field name="resident3" optional="show" string="Resident3- 79to156-Day Exp"/>
                <field name="resident4" optional="show" string="Resident4- 157to312-Day Exp"/>

                <field name="oncall_without_night" optional="show" string="OnCall-Add Exp-without overnight stay"/>
                <field name="oncall_with_night" optional="show" string="OnCall-Add Exp-with overnight stay"/>
                <field name="oncall_without_night1" optional="hide" string="OnCall-1 to19-without overnight stay"/>
                <field name="oncall_with_night1" optional="hide" string="OnCall-1 to19-with overnight stay"/>

                <field name="resident_without_night_1" optional="hide" string="Resident1- 20to27-without overnight stay"/>
                <field name="resident_with_night_1" optional="hide" string="Resident1- 20to27-with overnight stay"/>

                <field name="resident_without_night_2" optional="hide" string="Resident2- 28to78-without overnight stay"/>
                <field name="resident_with_night_2" optional="hide" string="Resident2- 28to78-with overnight stay"/>

                <field name="resident_without_night_3" optional="hide" string="Resident3-79to156-without overnight stayt stay"/>
                <field name="resident_with_night_3" optional="hide" string="Resident3-79to156-with overnight stayt stay"/>

                <field name="resident_without_night_4" optional="hide" string="Resident4- 157to312-Day Exp-without overnight stayt stay"/>
                <field name="resident_with_night_4" optional="hide" string="Resident4- 157to312-Day Exp-with overnight stayt stay"/>

                <field name="remote_call" optional="hide" string="RemoteCall-Reduction-Day"/>
                <field name="exp_remote" optional="hide" string="ExpRemote Call-HalfDayExp"/>

            </list>
        </field>
    </record>


    <record id="price_list_form_view" model="ir.ui.view">
        <field name="name">price.list.form</field>
        <field name="model">price.list</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="client_id" string="Client" options="{'no_create': True}" required="1"/>
                            <field name="client_name" string='Client selection' invisible="1"/>
                            <field name="pos" string='POS'/>
                            <field name="country" string='Country'/>
                            <field name="cat_location" string='Location'/>
                            <field name="services" string='Services'/>
                            <field name="employee_role" string='Role'/>
                            <separator string="Day Expenses" colspan="4"/>
                                <field name="oncall" string="OnCall-1 to 19"/>
                                <field name="resident1" string="Resident1- 20to27"/>
                                <field name="resident2" string=" Resident2- 28to78"/>
                                <field name="resident3" string=" Resident3- 79to156"/>
                                <field name="resident4" string=" Resident4- 157to312"/>
                            <separator string="Additional Expenses"/>
                                <field name="oncall_without_night" string="Without overnight"/>
                                <field name="oncall_with_night" string="With overnight"/>
                        </group>
                        <group>
                            <separator string="Without Overnight"/>
                                <field name="oncall_without_night1" string="OnCall-1 to19"/>
                                <field name="resident_without_night_1" string="Resident1- 20to27"/>
                                <field name="resident_without_night_2" string="Resident2- 28to78"/>
                                <field name="resident_without_night_3" string="Resident3-79to156"/>
                                <field name="resident_without_night_4" string="Resident4- 157to312"/>
                            <separator string="With Overnight"/>
                                <field name="oncall_with_night1" string="OnCall-1 to19"/>
                                <field name="resident_with_night_1" string="Resident1- 20to27"/>
                                <field name="resident_with_night_2" string="Resident2- 28to78"/>
                                <field name="resident_with_night_3" string="Resident3-79to156"/>
                                <field name="resident_with_night_4" string="Resident4- 157to312"/>

                            <separator string="Remote Call"/>
                                <field name="remote_call" string="Reduction-DayExp"/>
                                <field name="exp_remote" string="Half-DayExp"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_price_list_tecnimont" model="ir.actions.act_window">
        <field name="name">Tecnimont Price List</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">price.list</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>

    <record id="action_price_list_landt" model="ir.actions.act_window">
        <field name="name">L&amp;T Price List</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">price.list</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>

    <record id="action_price_list_tinhert" model="ir.actions.act_window">
        <field name="name">Tinhert Price List</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">price.list</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>

    <record id="gen_action_price_list" model="ir.actions.act_window">
        <field name="name">Invoices</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">invoice</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>


    <menuitem id="menu_invoice" groups="base.group_system,project_management.accounts_role"  name="Invoice" action="gen_action_price_list"/>

    <menuitem id="menu_price_list" name="Pricelist" sequence="1"  parent="menu_invoice"/>

    <menuitem id="menu_tech_price_list" name="Tecnimont Pricelist" action="action_price_list_tecnimont" parent="menu_price_list"/>

    <menuitem id="menu_lt_price_list" name="L&amp;T Pricelist" action="action_price_list_landt" parent="menu_price_list"/>

    <menuitem id="menu_tinhert_price_list" name="Tinhert Field Pricelist" action="action_price_list_tinhert" parent="menu_price_list"/>

</odoo>
