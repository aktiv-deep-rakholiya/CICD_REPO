<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_approve_state" model="ir.actions.server">
        <field name="name">Approve</field>
        <field name="model_id" ref="invoice.model_summary_report"/>
        <field name="binding_model_id" ref="invoice.model_summary_report"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">records=records.action_approve()</field>
    </record>

    <record id="action_not_approve_state" model="ir.actions.server">
        <field name="name">Not Approve</field>
        <field name="model_id" ref="invoice.model_summary_report"/>
        <field name="binding_model_id" ref="invoice.model_summary_report"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">records=records.action_unapprove()</field>
    </record>

    <record id="summary_list_view" model="ir.ui.view">
        <field name="name">summary.list.tree</field>
        <field name="model">summary.report</field>
        <field name="arch" type="xml">
            <list create="0" export_xlsx="0" delete="1" >
                <header>
                    <button name="invoice_btn" string="Create Invoice" type="object" class="oe_highlight" />
                </header>
                <field name="name" readonly="1"/>
                <field name="project_id" readonly="1"/>
                <field name="month_data" readonly="1"/>
                <field name="approve"/>
                <field name="not_approve"/>
                <field name="remark" />
                <field name="inspection_coordinator" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="summary_form_view" model="ir.ui.view">
        <field name="name">summary.form</field>
        <field name="model">summary.report</field>
        <field name="arch" type="xml">
            <form create="0" >
                <header>
                    <button name="invoice_btn" string="Create Invoice" type="object" class="oe_highlight"
                            invisible="not approve or invoiced"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoices" type="object" string="Invoices"
                                invisible="invoice_count == 0"
                                class="oe_stat_button" icon="fa-pencil-square-o" >
                             <field name="invoice_count" widget="statinfo" string="Invoices"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id" readonly="1"/>
                            <field name="month_data" readonly="1"/>
                            <field name="remark"/>
                            <field name="invoiced" invisible="1" force_save="1" readonly="1"/>
                            <field name="inspection_coordinator" force_save="1" widget="many2many_tags"/>
                            <field name="client_name" force_save="1" invisible="1"/>
                            <field name="client_id" force_save="1" widget="many2many_tags"/>
                             <field name="invoice_ids" invisible="1"/>
                            <field name="invoice_count" invisible="1"/>
                            <field name="purchase_date" invisible="1"/>
                            <label for="street_page_lead" string="Address" invisible="1"/>
                                <div class="o_address_format">
                                    <field name="street" id="street_page_lead" placeholder="Street..." class="o_address_street" readonly="1" force_save="1" invisible="1"/>
                                    <field name="street2" placeholder="Street 2..." class="o_address_street" readonly="1" force_save="1" invisible="1"/>
                                    <field name="city" placeholder="City" class="o_address_city" readonly="1" force_save="1" invisible="1"/>
                                    <field name="state_id" class="o_address_state" placeholder="State" options='{"no_open": True}' readonly="1" force_save="1" invisible="1"/>
                                    <field name="zip" placeholder="ZIP" class="o_address_zip" readonly="1" force_save="1" invisible="1"/>
                                    <field name="country_id" placeholder="Country" class="o_address_country" options='{"no_open": True, "no_create": True}' readonly="1" force_save="1" invisible="1"/>
                                </div>
                        </group>
                        <group>
                            <field name="date" readonly="1" force_save="1" invisible="1"/>
                            <field name="date_from" readonly="1" force_save="1"/>
                            <field name="date_to" readonly="1" force_save="1"/>
                            <field name="approve"/>
                            <field name="not_approve"/>
                            <field name="price_list" string="Price List" readonly="1" force_save="1" invisible="1"/>
                            <field name="pay_term" string="Payment Term" readonly="1" force_save="1" invisible="1"/>
                            <field name="currency" string="Currency" readonly="1" force_save="1" invisible="0"/>
                        </group>
                    </group>

                    <notebook>
                        <page string = "Internal Notes">
                            <field name="emp_list" string ="Project" readonly="1" force_save="1">
                                <list editable="bottom">
                                    <field name="calendar_ids"  widget="many2many_tags" string="Calendar" optional="hide"/>
                                    <field name="partner_ids" widget="many2many_tags" string="Vendors" optional="hide"/>
                                    <field name="purchase_id"  string="Purchase" optional="hide"/>
                                    <field name="tax_id" optional="hide" />
                                    <field name="overnight_expense" optional="hide" />
                                    <field name="with_stay" column_invisible="1" />
                                    <field name="without_stay" column_invisible="1"/>
                                    <field name="country" string="Country" optional="show"/>
                                    <field name="client_id" string="Client" optional="show"/>
                                    <field name="client_name" column_invisible="1" force_save="1" />
                                    <field name="employee_role" string="Role" optional="show" />
                                    <field name="cat_location" string="Location" optional="show" />
                                    <field name="category_expenses" string="JOB Duration" optional="show" />
                                    <field name="services" string="Services" optional="show"/>
                                    <field name="emp_name" optional="show"/>
                                    <field name="add_expenses" optional="show"/>
                                    <field name="days" optional="show" />
                                    <field name="emp_id" column_invisible="1" />
                                </list>
                                <form>
                                    <group>
                                        <group>
                                            <field name="emp_name" force_save="1" />
                                            <field name="country" string="Country"/>
                                            <field name="employee_role" string="Role"/>
                                        </group>
                                        <group>
                                            <field name="cat_location" string="Location"/>
                                            <field name="category_expenses" string="JOB Duration"/>
                                            <field name="services" string="Services"/>
                                            <field name="days" />
                                        </group>
                                    </group>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_summary_report_filter" model="ir.ui.view">
        <field name="name">summary.report.search</field>
        <field name="model">summary.report</field>
        <field name="arch" type="xml">
            <search string="Search Summary Items">
                <field name="project_id"/>
                <field name="month_data"/>
                <field name="client_id"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Project" name="group_by_project" domain="[]" context="{'group_by': 'project_id'}"/>
                    <filter string="Month Data" name="group_by_month" domain="[]" context="{'group_by': 'month_data'}"/>
                    <filter string="Client" name="group_by_client" domain="[]" context="{'group_by': 'client_id'}"/>
                </group>
            </search>
        </field>
    </record>


    <record id="action_summary" model="ir.actions.act_window">
        <field name="name">Timesheet Report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">summary.report</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>

    <menuitem id="menu_report_timesheet" name="Timesheet-Approval" action="action_summary" sequence="2"
              parent="invoice.menu_timesheet_summary" groups="base.group_system,project_management.accounts_role"/>

</odoo>
