<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="Currency_view_form" model="ir.ui.view">
        <field name="name">Currency Conversion</field>
        <field name="model">currency</field>
        <field name="arch" type="xml">
            <form string = "Currency Conversion">
                <group>
                    <group>
                        <field name="currency_from" string="From Currency"/>
                        <field name="currency_to" string="To Currency" readonly="1"/>
                        <field name="rate" string="Conversion Rate" readonly="1" force_save="1"/>
                    </group>
                </group>
            </form>
        </field>
    </record>

    <record id="Currency_view_tree" model="ir.ui.view">
        <field name="name">Currency Conversion</field>
        <field name="model">currency</field>
        <field name="arch" type="xml">
            <list>
                <field name="currency_from" string="From Currency"/>
                <field name="currency_to" string="To Currency"/>
                <field name="rate" string="Conversion Rate"/>
            </list>
        </field>
    </record>

    <record id="currency_action" model="ir.actions.act_window">
        <field name="name">Currency Conversion</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">currency</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_config" name="Configuration" sequence="99" parent="menu_invoice"/>
    <menuitem id="menu_currency" name="Currency Conversion" action="currency_action" parent="menu_config"/>
   
</odoo>
